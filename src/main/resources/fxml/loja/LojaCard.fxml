<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="300.0" maxWidth="400.0" prefHeight="340" prefWidth="300.0" stylesheets="@../../css/bloom.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.bcc.bloom.controller.loja.CardLojaController">
   <children>
      <VBox fx:id="containerLoja" alignment="TOP_CENTER" layoutX="158.0" layoutY="66.0" maxHeight="200.0" maxWidth="600.0" prefHeight="200.0" prefWidth="100.0" styleClass="card" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
             <ImageView fx:id="capaImg" fitHeight="140" fitWidth="300.0" pickOnBounds="true" preserveRatio="false" styleClass="card-imagem">
                 <Image url="@../../images/capa_padrão.png" />
             </ImageView>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <VBox>
                     <children>
                        <Label fx:id="nomeLojaLabel" styleClass="nome-loja" text="Nome da loja" />
                        <Label fx:id="descricaoLabel" styleClass="descricao-loja" text="Descrição" wrapText="true" />
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets left="20.0" right="20.0" />
               </padding>
            </HBox>
            <Button alignment="CENTER" maxWidth="Infinity" minWidth="0.0" mnemonicParsing="false" onAction="#verLoja" styleClass="botao-primario" text="Ver loja" textAlignment="CENTER">
               <VBox.margin>
                  <Insets left="10.0" right="10.0" />
               </VBox.margin>
            </Button>
         </children>
         <padding>
            <Insets left="10.0" right="10.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
