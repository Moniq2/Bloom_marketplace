<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- StackPane empilha dois estados: vendedor com loja e vendedor sem loja -->

<StackPane maxWidth="Infinity" minWidth="0" stylesheets="@../../css/bloom.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.bcc.bloom.controller.loja.MinhaLojaController">

    <!-- ===== Estado 1: vendedor com loja ===== -->
    <VBox fx:id="conteudoLoja" maxWidth="Infinity" minWidth="0" spacing="20">
        <padding>
            <Insets bottom="8" left="8" right="8" top="8" />
        </padding>

        <!-- Banner da loja: capa + logo + informacoes -->
        <VBox fx:id="bannerLoja" maxWidth="Infinity" minWidth="0" styleClass="banner-loja">

            <!-- Capa -->
            <StackPane fx:id="containerCapa" maxHeight="90" maxWidth="Infinity" minHeight="90" minWidth="0" prefHeight="90" styleClass="capa-loja">
                <ImageView fx:id="imagemCapa" fitHeight="90" preserveRatio="false" />
            </StackPane>

            <HBox alignment="BOTTOM_LEFT" maxWidth="Infinity" minWidth="0" spacing="16">
                <padding>
                    <Insets bottom="16" left="20" right="20" top="0" />
                </padding>

                <!-- Logo redonda, subindo sobre a capa (margem negativa) -->
                <StackPane styleClass="moldura-logo">
                    <HBox.margin>
                        <Insets top="-38" />
                    </HBox.margin>
                    <ImageView fx:id="imagemLogo" fitHeight="68" fitWidth="68" preserveRatio="false" />
                </StackPane>

                <!-- Nome, categoria, nota e status -->
                <VBox minWidth="0" spacing="4" HBox.hgrow="ALWAYS">
                    <Label fx:id="rotuloNomeLoja" minWidth="0" styleClass="titulo-formulario, nome-loja" text="Nome da loja" wrapText="true" />
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label fx:id="rotuloCategoria" styleClass="subtitulo" text="Categoria" />
                        <Label fx:id="rotuloNota" styleClass="subtitulo" text="★ 0,0 (0)" />
                        <Label fx:id="rotuloStatus" styleClass="etiqueta-status" text="Aberta" />
                    </HBox>
                </VBox>

                <Button fx:id="botaoEditarLoja" onAction="#aoClicarEditarLoja" styleClass="botao-paginacao" text="✎ Editar loja" />
            </HBox>
        </VBox>

        <!-- Titulo da secao de produtos + botao Novo produto -->
        <HBox alignment="CENTER_LEFT" maxWidth="Infinity" minWidth="0" spacing="10">
            <Label styleClass="titulo-formulario, titulo-secao" text="Meus produtos" />
            <Label fx:id="rotuloTotalProdutos" styleClass="subtitulo" text="0 produtos" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="botaoNovoProduto" onAction="#aoClicarNovoProduto" styleClass="botao-novo" text="+ Novo produto" />
        </HBox>

        <!-- Area rolavel onde os cards de produto serao adicionados pelo codigo -->
        <ScrollPane fx:id="rolagem" fitToWidth="true" hbarPolicy="NEVER" minWidth="0" styleClass="rolagem" VBox.vgrow="ALWAYS">
            <content>
                <VBox maxWidth="Infinity" minWidth="0" spacing="12">
                    <FlowPane fx:id="painelProdutos" maxWidth="Infinity" minWidth="0" hgap="16" vgap="16" />

                    <!-- Mensagem para quando a loja nao tem produtos -->
                    <Label fx:id="rotuloSemProdutos" managed="false" styleClass="subtitulo" text="Você ainda não cadastrou produtos." visible="false" />
                </VBox>
            </content>
        </ScrollPane>
    </VBox>

    <!-- ===== Estado 2: vendedor sem loja (comeca escondido) ===== -->
    <VBox fx:id="estadoSemLoja" alignment="CENTER" managed="false" spacing="12" visible="false">
        <Label styleClass="titulo-formulario" text="Você ainda não tem uma loja" />
        <Label styleClass="subtitulo" text="Crie sua loja para começar a vender seus produtos." />
        <Button onAction="#aoClicarCriarLoja" styleClass="botao-novo" text="Criar minha loja" />
    </VBox>
</StackPane>
