<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- StackPane empilha dois estados: usuario com pedidos e usuario sem pedidos -->

<StackPane stylesheets="@../../css/bloom.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.bcc.bloom.controller.pedido.PedidosController">

    <!-- ===== Estado 1: usuario com pedidos ===== -->
    <VBox fx:id="conteudoPedidos" spacing="6">
        <padding>
            <Insets bottom="8" left="8" right="8" top="8" />
        </padding>

        <Label styleClass="titulo-formulario" text="Meus pedidos" />
        <Label styleClass="subtitulo" text="Acompanhe suas compras" />

        <!-- Filtros por situacao. O userData identifica cada filtro no controller -->
        <HBox spacing="8">
            <padding>
                <Insets bottom="8" left="0" right="0" top="10" />
            </padding>

            <ToggleButton onAction="#aoClicarFiltro" selected="true" styleClass="filtro-pedido" text="Todos" userData="TODOS">
            <toggleGroup>
               <ToggleGroup fx:id="grupoFiltro" />
            </toggleGroup></ToggleButton>
            <ToggleButton onAction="#aoClicarFiltro" styleClass="filtro-pedido" text="Em andamento" toggleGroup="$grupoFiltro" userData="EM_ANDAMENTO" />
            <ToggleButton onAction="#aoClicarFiltro" styleClass="filtro-pedido" text="Entregues" toggleGroup="$grupoFiltro" userData="ENTREGUE" />
            <ToggleButton onAction="#aoClicarFiltro" styleClass="filtro-pedido" text="Cancelados" toggleGroup="$grupoFiltro" userData="CANCELADO" />
        </HBox>

        <!-- Area rolavel onde os cards de pedido serao adicionados pelo codigo -->
        <ScrollPane fx:id="rolagem" fitToWidth="true" styleClass="rolagem" VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="14">
                    <VBox fx:id="listaPedidos" spacing="14" />

                    <!-- Mensagem para quando o filtro nao encontra pedidos -->
                    <Label fx:id="rotuloSemResultado" managed="false" styleClass="subtitulo" text="Nenhum pedido nesta categoria." visible="false" />

                    <!-- Rodape da lista: botao Ver mais e contagem -->
                    <VBox fx:id="rodapeLista" alignment="CENTER" spacing="6">
                        <Button fx:id="botaoVerMais" onAction="#aoClicarVerMais" styleClass="botao-paginacao" text="Ver mais ▾" />
                        <Label fx:id="rotuloContagem" styleClass="subtitulo" text="Mostrando 0 de 0 pedidos" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>

        <!-- Grupo que garante que so um filtro fica selecionado por vez -->
        <fx:define>
            <ToggleGroup fx:id="grupoFiltro" />
        </fx:define>
    </VBox>

    <!-- ===== Estado 2: usuario sem pedidos (comeca escondido) ===== -->
    <VBox fx:id="estadoSemPedidos" alignment="CENTER" managed="false" spacing="12" visible="false">
        <Label styleClass="titulo-formulario" text="Você ainda não fez pedidos" />
        <Label styleClass="subtitulo" text="Que tal ver as colheitas de hoje?" />
        <Button onAction="#aoClicarVerLojas" styleClass="botao-buscar" text="Ver lojas" />
    </VBox>
</StackPane>
