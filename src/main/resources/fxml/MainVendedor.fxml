<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640" prefWidth="1000" styleClass="raiz-principal" stylesheets="@../css/barra-lateral.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.bcc.bloom.controller.MainVendedorController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="barra-superior" stylesheets="@../css/barra-lateral.css">
            <padding>
                <Insets bottom="10" left="16" right="20" top="10" />
            </padding>

            <Button fx:id="botaoMenu" onAction="#aoClicarBotaoMenu" styleClass="botao-menu" text="☰" />
            <Label styleClass="titulo-barra" text="Bloom" />
        </HBox>
    </top>

    <left>
        <VBox fx:id="barraLateral" maxWidth="-Infinity" minWidth="0" prefWidth="220" spacing="6" styleClass="barra-lateral">
            <padding>
                <Insets bottom="20" left="12" right="12" top="20" />
            </padding>

            <Button maxWidth="Infinity" onAction="#aoClicarInicio" styleClass="item-menu" text="Início" />
            <Button maxWidth="Infinity" onAction="#aoClicarPedidos" styleClass="item-menu" text="Pedidos" />
            <Button maxWidth="Infinity" onAction="#aoClicarMinhaLoja" styleClass="item-menu" text="Minha Loja" />
         <Button maxWidth="Infinity" onAction="#aoClicarConta" styleClass="item-menu" text="Conta" />
            <Button maxWidth="Infinity" onAction="#aoClicarSuporte" styleClass="item-menu" text="Suporte" />

            <Region VBox.vgrow="ALWAYS" />

            <Button maxWidth="Infinity" onAction="#aoClicarSair" styleClass="item-menu" text="Sair" />
        </VBox>
    </left>

    <center>
        <StackPane fx:id="areaConteudo" styleClass="area-conteudo">
            <Label styleClass="subtitulo" text="Conteúdo da tela aqui" />
        </StackPane>
    </center>
</BorderPane>
