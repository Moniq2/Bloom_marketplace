<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" styleClass="tela-lojas" stylesheets="@../css/bloom.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.bcc.bloom.controller.LojasController">

    <padding>
        <Insets bottom="8" left="8" right="8" top="8" />
    </padding>

    <!-- Titulo da tela -->
    <Label styleClass="titulo-formulario" text="Lojas para você" />

    <!-- Barra de pesquisa: Enter no campo ou clique no botao fazem a busca -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="campoBusca" onAction="#aoBuscar" promptText="Buscar loja pelo nome..." styleClass="campo" HBox.hgrow="ALWAYS" />
        <Button onAction="#aoBuscar" styleClass="botao-buscar" text="Buscar" />
    </HBox>

    <!-- Area rolavel onde os cards das lojas serao adicionados pelo codigo -->
    <ScrollPane fx:id="rolagem" fitToWidth="true" styleClass="rolagem" VBox.vgrow="ALWAYS">
        <content>
            <VBox spacing="12">
                <!-- FlowPane coloca os cards lado a lado e quebra a linha sozinho -->
                <FlowPane fx:id="painelLojas" hgap="20" vgap="20" />

                <!-- Mensagem para quando nenhuma loja for encontrada -->
                <Label fx:id="rotuloVazio" managed="false" styleClass="subtitulo" text="Nenhuma loja encontrada." visible="false" />
            </VBox>
        </content>
    </ScrollPane>

    <!-- Controles de paginacao -->
    <HBox alignment="CENTER" spacing="16">
        <Button fx:id="botaoAnterior" onAction="#aoClicarAnterior" styleClass="botao-paginacao" text="‹ Anterior" />
        <Label fx:id="rotuloPagina" styleClass="rotulo-pagina" text="Página 1 de 1" />
        <Button fx:id="botaoProxima" onAction="#aoClicarProxima" styleClass="botao-paginacao" text="Próxima ›" />
    </HBox>
</VBox>
