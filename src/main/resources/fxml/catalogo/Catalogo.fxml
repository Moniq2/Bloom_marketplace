<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="6" stylesheets="@../../css/bloom.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.bcc.bloom.controller.produto.CatalogoController">

    <padding>
        <Insets bottom="8" left="8" right="8" top="8" />
    </padding>

    <Label styleClass="titulo-formulario" text="Catálogo" />
    <Label styleClass="subtitulo" text="Todos os produtos de todas as lojas" />

    <!-- Area rolavel: os cards de produto e a paginacao ficam dentro dela -->
    <ScrollPane fx:id="rolagem" fitToWidth="true" styleClass="rolagem" VBox.vgrow="ALWAYS">
        <content>
            <VBox spacing="22">
                <padding>
                    <Insets bottom="0" left="0" right="0" top="10" />
                </padding>

                <!-- Os cards de produto sao adicionados aqui pelo codigo -->
                <FlowPane fx:id="painelProdutos" hgap="16" vgap="16" />

                <!-- Mensagem para quando nao ha produtos -->
                <Label fx:id="rotuloSemProdutos" managed="false" styleClass="subtitulo" text="Nenhum produto disponível." visible="false" />

                <!-- Paginacao no final da lista -->
                <HBox fx:id="barraPaginacao" alignment="CENTER" spacing="16">
                    <padding>
                        <Insets bottom="12" left="0" right="0" top="0" />
                    </padding>

                    <Button fx:id="botaoAnterior" onAction="#aoClicarAnterior" styleClass="botao-paginacao" text="‹ Anterior" />
                    <Label fx:id="rotuloPagina" styleClass="rotulo-pagina" text="Página 1 de 1" />
                    <Button fx:id="botaoProxima" onAction="#aoClicarProxima" styleClass="botao-paginacao" text="Próxima ›" />
                </HBox>
            </VBox>
        </content>
    </ScrollPane>
</VBox>
