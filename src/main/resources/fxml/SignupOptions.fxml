<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="560" prefWidth="900" styleClass="raiz-login" stylesheets="@../css/bloom.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.bcc.bloom.controller.SignupOptionsController">

    <!-- logo e slogan -->
    <VBox alignment="CENTER" maxWidth="500.0" minWidth="380" prefWidth="380.0" spacing="14" styleClass="painel-lateral" stylesheets="@../css/bloom.css">
        <padding>
            <Insets bottom="40" left="40" right="40" top="40" />
        </padding>

        <ImageView fitHeight="150" fitWidth="150" preserveRatio="true">
            <image>
                <Image url="@../images/Logo2.png" />
            </image>
        </ImageView>

        <Label styleClass="titulo-marca" text="Bloom" />
        <Label styleClass="slogan" text="Do campo para a sua mesa" />
    </VBox>

    <!-- formulario de login -->
    <VBox alignment="CENTER_LEFT" spacing="8" styleClass="painel-formulario" HBox.hgrow="ALWAYS">

        <Label styleClass="titulo-formulario" text="O que você está buscando?" />

        <!-- Mensagem de erro: comeca escondida e sem ocupar espaco -->
        <Label fx:id="rotuloErro" managed="false" styleClass="mensagem-erro" visible="false" />

        <HBox alignment="CENTER" spacing="4" />
      <Button fx:id="botaoComprador" maxWidth="Infinity" onAction="#abrirTelaCadastroUsuario" styleClass="botao-primario" text="Quero fazer compras" />
      <Button fx:id="botaoVendedor" maxWidth="Infinity" onAction="#abrirTelaCadastroVendedor" styleClass="botao-primario" text="Quero vender meus produtos" />

        <Hyperlink onAction="#voltar" styleClass="link-verde" text="voltar" />
    </VBox>
</HBox>
